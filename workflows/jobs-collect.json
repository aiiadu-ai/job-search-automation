    {
      "id": "3b755d46-cdf6-4a85-bb7f-6b6550870eda",
      "name": "Job inbox (last 7 days)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": true,
        "simple": false,
        "filters": {
          "readStatus": "both",
          "q": "newer_than:7d"
        },
        "options": {}
      },
