    {
      "id": "c845a55f-d207-4b00-9354-b397c5d10df1",
      "name": "Classify emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const clean = (t) => (t || '').replace(/<https?:[^>]+>/g, ' ').replace(/https?:\\/\\/\\S+/g, ' ').replace(/[ \\t]+/g, ' ').replace(/\\n{2,}/g, '\\n').trim();\nconst SERVICE = /DOU Daily|Як швидко|security|безпеки|verify|confirm|підтверд|код|code|парол|password|welcome|ласкаво/i;\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  if (!j.id) continue;\n  const from = ((j.from && j.from.value && j.from.value[0] && j.from.value[0].address) || '').toLowerCase();\n  const subject = j.subject || '';\n  const raw = j.text || '';\n  const date = j.date || new Date().toISOString();\n  if (from.includes('djinni.co') && /Пропозиція від|Offer from|message/i.test(subject + raw.slice(0, 200))) {\n    const chat = (raw.match(/https:\\/\\/djinni\\.co\\/my\\/inbox\\/\\d+\\/?/) || [''])[0];\n    const sm = subject.match(/(?:Пропозиція від|Offer from)\\s+(.+?),\\s*(.+)$/i);\n    out.push({ json: {\n      key: chat ? 'djinni-' + chat.replace(/\\D/g, '') : 'mail-' + j.id,\n      source: 'Djinni', kind: 'direct',\n      title: subject, company: sm ? sm[2].trim() : '',\n      link: chat, chat_link: chat,\n      recruiter: sm ? sm[1].trim() : '', recruiter_email: '',\n      text: clean(raw).slice(0, 4000), received_at: date,\n    }});\n    continue;\n  }\n  if (SERVICE.test(subject)) continue;\n  const replyTo = (j.replyTo && j.replyTo.value && j.replyTo.value[0] && j.replyTo.value[0].address) || '';\n  const isBoard = /jooble|work\\.ua|robota\\.ua|rabota\\.ua|djinni|linkedin|dou\\.ua/.test(from);\n  if (isBoard) {\n    out.push({ json: {\n      key: 'mail-' + j.id,\n      source: from.includes('jooble') ? 'Jooble' : from.includes('work.ua') ? 'Work.ua' : from.includes('dou.ua') ? 'DOU' : from.split('@')[1] || from,\n      kind: 'digest_email',\n      title: subject, company: '', link: '', chat_link: '', recruiter: '', recruiter_email: '',\n      text: (raw || '').slice(0, 8000), received_at: date,\n    }});\n    continue;\n  }\n  // a real person wrote to the job inbox\n  if (!/no-?reply|notification|mailer|google\\.com/.test(from)) {\n    out.push({ json: {\n      key: 'mail-' + j.id, source: 'Email', kind: 'direct',\n      title: subject, company: '', link: '', chat_link: '',\n      recruiter: (j.from && j.from.value && j.from.value[0] && j.from.value[0].name) || '',\n      recruiter_email: replyTo || from,\n      text: clean(raw).slice(0, 4000), received_at: date,\n    }});\n  }\n}\nreturn out;\n"
      },
      "alwaysOutputData": true
    },
    {
      "id": "0b3f08b2-ffe4-4254-9c1f-71a912431236",
      "name": "Dedupe in batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const it of $input.all()) {\n  const k = it.json.key;\n  if (!k || seen.has(k)) continue;\n  seen.add(k);\n  out.push(it);\n}\nreturn out;\n"
      }
    },
